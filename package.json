{
  "name": "llm-assessment-pipeline",
  "version": "1.0.0",
  "description": "LangChain demo that generates Zod-validated assessment questions with dual-model failover (GPT-4o-mini primary, Gemini 1.5 Flash fallback).",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -w src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "assets": "node scripts/make-readme-svg.mjs"
  },
  "keywords": [
    "langchain",
    "llm",
    "zod",
    "fault-tolerant",
    "openai",
    "gemini",
    "typescript"
  ],
  "author": "Sudhanshu Singh",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^1.3.1",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/openai": "^1.8.0",
    "dotenv": "^17.4.2",
    "langchain": "^1.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "nodemon": "^3.1.14",
    "vitest": "^4.1.12"
  }
}
